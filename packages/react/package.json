{
  "name": "@mhcalendar/react",
  "version": "0.3.1",
  "description": "React wrapper for @mhcalendar/calendar web components",
  "repository": {
    "type": "git",
    "url": "https://github.com/mhcalendar/mhcalendar.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/mhcalendar/mhcalendar/tree/main/packages/react#readme",
  "bugs": "https://github.com/mhcalendar/mhcalendar/issues",
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "yalc:watch": "nodemon --watch dist --exec 'yalc push --sig'",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write ."
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@mhcalendar/calendar": "^0.3.1",
    "@stencil/react-output-target": "^1.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.59.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
