{
  "name": "@mhcalendar/calendar",
  "version": "0.2.5",
  "description": "mhcalendar — Stencil web component",
  "repository": {
    "type": "git",
    "url": "https://github.com/mhcalendar/mhcalendar.git",
    "directory": "packages/calendar"
  },
  "homepage": "https://github.com/mhcalendar/mhcalendar/tree/main/packages/calendar#readme",
  "bugs": "https://github.com/mhcalendar/mhcalendar/issues",
  "type": "module",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/mhcalendar-calendar/mhcalendar-calendar.esm.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs.js"
    },
    "./loader": {
      "types": "./loader/index.d.ts",
      "import": "./loader/index.js",
      "require": "./loader/index.cjs.js"
    },
    "./dist/components": {
      "types": "./dist/types/components.d.ts",
      "import": "./dist/components/index.js"
    },
    "./dist/components/*": "./dist/components/*"
  },
  "files": [
    "dist/",
    "loader/"
  ],
  "scripts": {
    "prebuild": "rm -rf dist loader",
    "build": "stencil build",
    "watch": "stencil build --watch",
    "start": "stencil build --dev --watch --serve",
    "dev": "stencil build --watch --serve",
    "pretest": "stencil build",
    "test": "stencil-test",
    "test:watch": "stencil-test --watch",
    "test:unit": "stencil-test --project unit",
    "test:spec": "stencil-test --project spec",
    "generate": "stencil generate",
    "format": "prettier --write .",
    "yalc:watch": "nodemon --watch dist --exec 'yalc push --sig'",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@stencil/core": "^4.27.1",
    "@stencil/eslint-plugin": "^1.2.0",
    "@stencil/react-output-target": "^1.0.3",
    "@stencil/store": "^2.1.3",
    "@stencil/vitest": "^1.13.3",
    "@types/node": "^22.13.5",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.5.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.59.0",
    "vitest": "^4.1.10"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "dayjs": "^1.11.13"
  }
}
