{
  "name": "root",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*",
    "apps/*"
  ],
  "scripts": {
    "build": "lerna run build",
    "build:calendar": "lerna run build --scope=@mhcalendar/calendar",
    "build:react": "lerna run build --scope=@mhcalendar/react",
    "dev": "lerna run dev --scope=@mhcalendar/calendar",
    "start": "lerna run start --scope=@mhcalendar/calendar",
    "react": "npm run watch --workspace @mhcalendar/calendar & npm run dev --workspace @mhcalendar/react & npm run dev --workspace @mhcalendar/example-react-19-vite & wait",
    "docs": "npm run start --workspace apps-docs",
    "docs:build": "npm run build --workspace apps-docs",
    "test": "lerna run test",
    "lint": "lerna run lint",
    "format": "lerna run format",
    "clean": "lerna run clean --parallel"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "lerna": "^9.0.7",
    "typescript": "^5.5.4",
    "workbox-build": "^4.3.1"
  }
}
